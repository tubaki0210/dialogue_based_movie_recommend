# 1. 軽量な Python 3.10 オフィシャルイメージを使用
FROM python:3.10-slim

# 環境変数の設定
# - PYTHONDONTWRITEBYTECODE: .pyc ファイルの生成を抑制
# - PYTHONUNBUFFERED: ログをリアルタイムで出力
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 作業ディレクトリの設定（コンテナ内の /app で作業）
WORKDIR /app

# 2. 必要なシステムパッケージのインストール（PostgreSQL接続等に必要なビルドツール）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*
# 3. 依存ライブラリ一覧（requirements.txt）のコピーとインストール
# ※ キャッシュを効率的に使うため、ソースコード全体のコピーより先に依存関係を処理
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 4. バックエンドのソースコードとモデルファイル等をすべてコンテナにコピー
COPY . .

# 5. Render が割り当てるポート番号（デフォルト 10000）の公開設定
EXPOSE 10000

# 6. アプリケーションの起動コマンド
# Render は環境変数 PORT を提供するため、$PORT を使用します
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-10000}"]